{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makerjackie-blog",
  "main": "./src/server.ts",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 9 * * *"],
  },
  "routes": [
    {
      "pattern": "new.makerjackie.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "VITE_BASE_URL": "https://new.makerjackie.com",
    "CMS_PUBLIC_SITE_URL": "https://new.makerjackie.com",
    "CMS_BACKUP_RETENTION_DAYS": "30",
    "CMS_EMAIL_SENDING_ENABLED": "false",
    "CMS_EMAIL_FROM": "",
    "CMS_EMAIL_TO": "",
    "CMS_PASSWORD_RESET_TTL_MINUTES": "30",
    "VITE_TURNSTILE_SITE_KEY": "",
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "makerjackie-blog-cms",
      "database_id": "96cc91a6-6b58-4fca-983c-ac362a6410bd",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CMS_STORAGE",
      "bucket_name": "makerjackie-blog-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CMS_CACHE",
      "id": "1c07f15c64f2482c93edba68fc71b995",
    },
  ],
}
